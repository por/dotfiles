#!/bin/bash
#
# Usage: git tidy
#
# Delete local branches that are merged into the default branch, or whose
# upstream is gone and whose files all match the default branch, which is how
# a squash-merged PR looks. Lists them and asks first. Skips the default
# branch, anything checked out in a worktree, and gone branches with work that
# is not in the default branch.

git rev-parse --git-dir >/dev/null || exit 1

git fetch --prune --quiet || echo "git tidy: fetch failed, using local state" >&2
git worktree prune

base=$(git default-branch) || exit 1

keep=$(
  echo "${base#origin/}"
  git worktree list --porcelain | sed -n 's|^branch refs/heads/||p'
)

# Every file the branch ever touched is identical in base: nothing on the
# branch, including a later partial revert, is missing from base.
squash_merged() {
  local ref="refs/heads/$1" mb
  mb=$(git merge-base "$base" "$ref") || return 1
  # diff-tree, unlike log and diff, ignores diff.relative and diff.ignoreSubmodules.
  [ -z "$(LC_ALL=C comm -12 \
    <(git rev-list "$mb..$ref" | git diff-tree --stdin -r -m --root --no-commit-id --name-only --no-renames | LC_ALL=C sort -u) \
    <(git diff-tree -r --name-only --no-renames "$base" "$ref" | LC_ALL=C sort -u))" ]
}

merged=$(git for-each-ref --merged="$base" --format='%(refname:lstrip=2)' refs/heads | grep -vxF -f <(echo "$keep"))
squashed=""
unmerged=""
for branch in $(git for-each-ref --format='%(refname:lstrip=2) %(upstream:track)' refs/heads |
  awk '$2 == "[gone]" { print $1 }' | grep -vxF -f <(echo "$keep")); do
  echo "$merged" | grep -qxF "$branch" && continue
  if squash_merged "$branch"; then
    squashed+="$branch"$'\n'
  else
    ahead=$(git rev-list --count "$base..refs/heads/$branch")
    [ "$ahead" = 1 ] && word=commit || word=commits
    unmerged+="  $branch ($ahead $word not in $base)"$'\n'
  fi
done
squashed=${squashed%$'\n'}

if [ -n "$unmerged" ]; then
  echo "Gone from the remote but with work not in $base, so kept:"
  printf '%s' "$unmerged"
  echo "  Delete one with: git branch -D <branch>"
  echo ""
fi

if [ -z "$merged" ] && [ -z "$squashed" ]; then
  echo "Nothing to tidy."
  exit 0
fi

echo "Merged into $base:"
printf '%s\n' "$merged" "$squashed" | grep -v '^$' | awk '{ print "  " $0 }'
count=$(printf '%s\n' "$merged" "$squashed" | grep -c .)
read -r -p "Delete $count branches? [y/N] " answer
[ "$answer" = y ] || [ "$answer" = Y ] || exit 0

printf '%s\n' "$merged" "$squashed" | grep -v '^$' | while IFS= read -r branch; do
  git branch -D "$branch"
done
