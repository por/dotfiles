cask_args appdir: '/Applications'

# Driver casks needed for e.g. Sonos
tap 'homebrew/cask-drivers'
# Older app versions needed for e.g. 1password7
tap 'homebrew/cask-versions'

# Utils
brew 'act'                # Run GitHub Actions locally
brew 'cloudflared'        # Cloudflare Tunnel client
brew 'coreutils'          # GNU core utilities (ls, cat, etc.)
brew 'curl'               # Command-line tool for transferring data
brew 'ffmpeg'             # Multimedia framework for video/audio processing
brew 'fzf'                # Fuzzy finder for command-line
brew 'jq'                 # JSON processor and query tool
brew 'mise'               # Runtime version manager (formerly rtx)
brew 'starship'           # Cross-shell prompt with customization
brew 'yt-dlp'             # YouTube and video downloader

# Apps
cask 'airflow'            # Apache Airflow workflow management platform
cask 'brave-browser'      # Web browser
cask 'bruno'              # API client for testing and development
cask 'calibre'            # E-book library management
cask 'claude'             # Claude desktop app
cask 'figma'              # Design and prototyping tool
cask 'firefox'            # Web browser
cask 'gh'                 # GitHub CLI
cask 'google-chrome'      # Web browser
cask 'imageoptim'         # Image optimization and compression tool
cask 'iterm2'             # Terminal emulator for macOS
cask 'microsoft-edge'     # Web browser
cask 'mullvad-vpn'        # VPN client for privacy and security
cask 'netnewswire'        # RSS reader
cask 'orbstack'           # Container platform alternative to Docker Desktop
cask 'raycast'            # Productivity launcher and command palette
cask 'signal'             # Encrypted messaging app
cask 'slack'              # Team communication and collaboration
cask 'sonos'              # Sonos speaker app
cask 'tableplus'          # Database management and SQL client
cask 'transmission'       # BitTorrent client
cask 'visual-studio-code' # Code editor
cask 'vlc'                # Media player
cask 'whatsapp'           # Messaging app
cask 'zoom'               # Video conferencing and meetings
