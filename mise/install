#!/bin/bash
# Link the global mise config and install its tools

# A machine's own config is kept as config.toml.backup to merge by hand
target="$HOME/.config/mise/config.toml"
mkdir -p "$(dirname "$target")"
if [ -f "$target" ] && [ ! -L "$target" ]; then
    mv "$target" "$target.backup"
fi
ln -sfn "$HOME/.dotfiles/mise/config.toml" "$target"

mise install

mkdir -p "$HOME/.config/uv"
ln -sfn "$HOME/.dotfiles/mise/uv.toml" "$HOME/.config/uv/uv.toml"

# npm writes auth tokens to ~/.npmrc, so it is edited in place and never linked
mise exec -- npm config set --location=user min-release-age 1
mise exec -- npm config set --location=user ignore-scripts true

# pnpm reads neither of the npm settings above; this one is in minutes and
# needs pnpm 10.16+, so a project pinning an older packageManager skips it
mise exec -- pnpm config set --location=global minimum-release-age 1440
