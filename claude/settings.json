{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/Library/Application Support/mkcert/rootCA-key.pem)",
      "Read(~/.codex/auth.json)",
      "Read(~/.config/rclone/**)",
      "Read(~/.config/gh/**)",
      "Read(~/Library/Preferences/.wrangler/**)",
      "Read(~/.aws/**)",
      "Bash(gh auth *)"
    ],
    "ask": [
      "Bash(dangerouslyDisableSandbox:true)",
      "Bash(gh repo delete *)"
    ],
    "defaultMode": "auto"
  },
  "sandbox": {
    "enabled": true,
    "excludedCommands": [
      "gh *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/Library/pnpm",
        "~/.npm"
      ]
    },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "github.com",
        "*.github.com",
        "*.githubusercontent.com"
      ],
      "allowLocalBinding": true
    }
  },
  "disableClaudeAiConnectors": true,
  "statusLine": {
    "type": "command",
    "command": "~/.dotfiles/claude/statusline.sh"
  },
  "tui": "fullscreen",
  "alwaysThinkingEnabled": true,
  "agentPushNotifEnabled": true,
  "enableWorkflows": true,
  "skipWorkflowUsageWarning": true
}
