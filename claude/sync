#!/bin/bash
# Sync enabled skills into Claude config

set -e

SKILLS_SRC="$HOME/.dotfiles/agents/skills"
SKILLS_STATE="$HOME/.dotfiles/agents/skills-enabled"
SKILLS_DST="$HOME/.claude/skills"

mkdir -p "$SKILLS_DST"

# Enable all selected skills
for link in "$SKILLS_STATE"/*; do
    [ -L "$link" ] || continue
    skill=$(basename "$link")
    if [ -d "$SKILLS_SRC/$skill" ]; then
        ln -sfn "$SKILLS_SRC/$skill" "$SKILLS_DST/$skill"
    fi
done

# Remove skills that are no longer enabled
for link in "$SKILLS_DST"/*; do
    [ -L "$link" ] || continue
    skill=$(basename "$link")
    if [ ! -L "$SKILLS_STATE/$skill" ]; then
        rm -f "$SKILLS_DST/$skill"
    fi
done
