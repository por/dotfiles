#!/usr/bin/env bash
#
# Run all dotfiles installers.

set -e

cd "$(dirname $0)"/..

# Run Homebrew through the Brewfile
echo "› brew bundle"
brew bundle

# Each topic's installer, one level deep: agents/skills holds third-party repos
for installer in ./*/install; do
  [ "$installer" = ./script/install ] || [ ! -f "$installer" ] || sh -c "$installer"
done
