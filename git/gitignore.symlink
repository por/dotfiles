# Applies to every repo, so only names that are never real source belong here.
# A folder name like logs/ or env/ would also hide app/logs/page.tsx or
# src/env/ everywhere; those go in each project's own .gitignore.

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride

# Editors
.idea/
*.swp
*.swo
*~
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Agents: personal settings and worktrees, not the shared .claude/ config
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md

# Secrets
.env
.env.*
!.env.example

# Logs
*.log

# Node.js and framework caches
node_modules/
.pnpm-store/
.npm
.eslintcache
.node_repl_history
*.tsbuildinfo
.next/
.astro/
.turbo/
.vercel/
.cache/
.parcel-cache/

# Python
__pycache__/
*.py[cod]
.venv/
